MYSQL_ROOT_PASSWORD=replace-with-long-random-password
AGENT_SERVICE_TOKEN=replace-with-agent-service-token
BACKEND_JWT_SECRET=replace-with-at-least-32-byte-random-secret
BACKEND_CORS_ORIGINS=https://campus.example.edu
HTTP_PORT=80

# Agent 模型；未配置密钥时基础浏览可用，但问答与 AI 任务会明确报“模型未配置”。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_ID=gpt-4o-mini

# 以下能力默认关闭，按真实验收结果逐项开启。
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_BROWSER_ENABLED=false
RAG_ENABLED=false
KNOWLEDGE_ROOT=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=

# Agent 功能默认关闭，完成真实环境验证后再逐项开启。
RUN_CONTROL_ENABLED=false
SKILL_INJECTION_ENABLED=false
MCP_UPSTREAM_SERVERS=[]
